# Configuration Caddy : reverse proxy HTTPS automatique (certificat Let's
# Encrypt obtenu et renouvelé seul) vers la plateforme GRC.
#
# {$DOMAIN} est substitué par la variable d'environnement DOMAIN définie dans
# .env (ex: DOMAIN=grc.mon-organisation.sn) — le DNS de ce domaine doit
# pointer vers l'adresse IP publique du serveur avant le premier démarrage,
# pour que Caddy puisse valider le certificat.

{$DOMAIN} {
	reverse_proxy app:8501
}
